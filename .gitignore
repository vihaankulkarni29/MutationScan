# Run state and outputs. Everything a run produces lives under data/output/.
.snakemake/

# Any other folder you create under data/ is yours and is never tracked --
# private cohorts, scratch dirs, downloads. Only the scaffold below is in git.
data/*/
!data/genomes/
!data/references/
!data/databases/
!data/output/
!data/results/

# User-supplied inputs and run outputs. These are your data, not the tool's
# source: genomes and reference proteins are organism-specific and must never be
# baked into the repo. The .gitkeep files keep the empty scaffold in git.
data/genomes/*
!data/genomes/.gitkeep
data/references/*
!data/references/.gitkeep
!data/references/*_WT.faa
data/databases/*
!data/databases/.gitkeep
data/output/*
!data/output/.gitkeep
data/results/*
!data/results/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
.Python
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv

# Testing, coverage, type checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Agent tooling state. Deliberately untracked: it is per-machine scratch, not
# project source.
.claude/

# Logs, caches, scratch
logs/
*.log
.cache/
*.tmp
*.bak

# Docker
docker-compose.override.yml

# Benchmark generated artifacts: synthetic cohorts, ground truth,
# reports and tool run outputs are reproducible, not source.
# Ignoring the *contents* rather than the directory itself matters:
# git does not descend into an excluded directory, so a file inside
# one cannot be re-included, and the documented example fixtures
# below are hand-written source that should be tracked.
benchmarks/data/*
!benchmarks/data/.gitkeep
!benchmarks/data/*.example.tsv
benchmarks/results/
benchmarks/runs/
